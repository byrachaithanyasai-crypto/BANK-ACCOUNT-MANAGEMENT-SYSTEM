# BACKEND CONFIGURATION
# Production MySQL Database Connection String
DATABASE_URL=mysql+mysqlconnector://user:password@host/dbname

# JWT Secret Key (Use a strong, random 256-bit string)
JWT_SECRET_KEY=your_super_secret_key_here

# JWT Algorithm and Expiration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend URL for CORS configuration (Use your deployed frontend URL or *)
FRONTEND_URL=https://your-frontend-app.onrender.com

# FRONTEND CONFIGURATION (Injected at build time via Vite)
# The URL where your FastAPI backend is hosted
VITE_API_BASE_URL=https://your-backend-api.onrender.com
